+/* A guest that retries a failing jumbo reserve in a tight loop (observed: a
+ * game walking a 4GB hint upward from 0x8000000000, ~5M calls) used to write
+ * ~4 lines per call, a 1.5GB log in minutes. Keep every success and the first
+ * IOS_JUMBO_FAIL_LOG_FIRST failures; after that print every
+ * IOS_JUMBO_FAIL_LOG_EVERY-th failure. Counters keep counting regardless. */
+#define IOS_JUMBO_FAIL_LOG_FIRST 64
+#define IOS_JUMBO_FAIL_LOG_EVERY 4096
+
+static int ios_jumbo_fail_log_ok( void )
+{
+    return ios_jumbo_fail < IOS_JUMBO_FAIL_LOG_FIRST ||
+           (ios_jumbo_fail % IOS_JUMBO_FAIL_LOG_EVERY) == 0;
+}
